            - 0
            - 0
          localScale:
            - 1
            - 1
            - 1
        MeshRenderer:
          name: MeshRenderer
          enabled: true
          mesh:
            name: Cylinder.001
          material:
            wrap_mode: Repeat
            filter: Nearest
            color:
              - 0.800000012
